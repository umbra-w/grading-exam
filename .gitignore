# 依赖包
node_modules/
.pnpm-store/

# 构建与打包输出
out/
dist/
release/
*.log

# 运行时数据与配置 (便携版运行时目录，严禁提交个人/真实答题数据)
data/
*.local.json

# 系统与 IDE 缓存
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.user

# 环境变量与私密配置
.env
.env.local
.env.*.local

# 评测与原始答卷数据集 (含学生个人隐私，严禁入库)
data/raw/
data/derived/

# 界面预览生成物 (截图与 DOM dump 为临时产物)
preview/shot-*.png
preview/dom-*.html

# Python 缓存 (AGENTS 防侧漏规范)
__pycache__/
*.pyc
*.pyo

# 临时与构建残余文件
build/*.tmp
*.tmp
